{
  "manifest_version": 3,
  "name": "AutoList for Facebook Marketplace - Bulk Lister & Automation",
  "version": "2.0.0",
  "description": "Bulk upload and fill Facebook Marketplace listings. Auto-fill titles, prices, descriptions, and IMAGEs.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data.json",
        "images/*.jpg"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ]
    }
  ]
}

